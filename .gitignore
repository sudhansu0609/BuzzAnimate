/target
**/*.rs.bk
*.pdb

# Setup wizard (scripts/app_installer): SmartCleaner's marker and the setup log.
/installer/installed.json
/installer/*.exe
/logs/

# BuzzAnimate local state
/settings.local.json
/.buzz-cache/
/out/
/scratchpad/

# Documents and the recovery files autosave writes beside them. Test fixtures
# and hand-made scratch documents must never be committed.
*.buzz

# The Claude proxy key (CLAUDE_API_KEY) lives here. Never commit it;
# .env.example shows the shape.
.env
.env.*
!.env.example

# local image datasets (staging/storyboard reference stills)
/dataset2/
installer/setup.running
